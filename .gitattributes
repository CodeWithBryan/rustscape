# Fixtures and pinned sources are hashed byte for byte, so check out LF everywhere.
* text=auto eol=lf
*.rs text eol=lf
*.java text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.bin binary
*.png binary
*.wav binary
*.dat2 binary
*.idx* binary
# Vendored sources are checked byte for byte against their provenance
# (tools/check_macroquad_vendor.py): no line-ending conversion.
vendor/macroquad/** -text
